<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Build-menu entry for the yard tool (UeyYardZoneBrush, parameter "zone").
     Never placed: it only carries the brush. The brush type is registered by
     main.lua; in a mod's environment its name is prefixed with the mod name. -->
<placeable type="FS25_UsedEquipmentYards.usedEquipmentYardTool">
    <storeData>
        <name>$l10n_uey_tool_zone</name>
        <functions>
            <function>$l10n_uey_tool_zone_function</function>
        </functions>
        <image>store/store_yard.dds</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>misc</category>
        <canBeSold>false</canBeSold>
        <showInStore>true</showInStore>

        <brush>
            <type>FS25_UsedEquipmentYards.ueyYardZone</type>
            <category>buildings</category>
            <tab>tools</tab>
            <parameters>
                <parameter>zone</parameter>
            </parameters>
        </brush>
    </storeData>

    <base>
        <filename>i3d/box.i3d</filename>
        <canBeRenamed>false</canBeRenamed>
        <boughtWithFarmland>false</boughtWithFarmland>
    </base>

    <placement>
        <testAreas>
            <testArea startNode="testAreaStart" endNode="testAreaEnd" />
        </testAreas>
    </placement>

    <i3dMappings>
        <i3dMapping id="testAreaStart" node="0>2|0" />
        <i3dMapping id="testAreaEnd"   node="0>2|0|0" />
    </i3dMappings>
</placeable>
